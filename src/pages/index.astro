---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.tsx';
import FeatureGrid from '../components/FeatureGrid.tsx';
import WhyChooseUs from '../components/WhyChooseUs.tsx';
import PrivacySecurity from '../components/PrivacySecurity.tsx';
import Footer from '../components/Footer.tsx';
---

<Layout 
  title="lifio - Master your day, your health, and your wealth in one place" 
  description="All-in-one personal tracking mobile app. Track daily vitals, log spending, write journal notes, and build habit streaks with 100% local privacy."
>
  <Navbar client:load />
  
  <main>
    <Hero client:load />
    <FeatureGrid client:visible />
    <WhyChooseUs client:visible />
    <PrivacySecurity client:visible />
  </main>
  
  <Footer client:idle />
</Layout>
