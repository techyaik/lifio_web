---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Hero from '../components/Hero.jsx';
import Features from '../components/Features.jsx';
import ScreenshotsSection from '../components/ScreenshotsSection.jsx';
import HealthConnectSection from '../components/HealthConnectSection.jsx';
import PrivacyPolicy from '../components/PrivacyPolicy.jsx';
import FAQ from '../components/FAQ.jsx';
import AppShowcase from '../components/AppShowcase.jsx';
import Footer from '../components/Footer.jsx';
---

<Layout 
  title="Lifio | Offline Health, Habits, Wallet & Notes Tracker" 
  description="Lifio is an offline personal tracking app for Android. Track your health vitals, habit streaks, wallet expenses, and personal notes with 100% local storage."
>
  <Navbar client:load />
  <main>
    <Hero client:load />
    <Features client:visible />
    <ScreenshotsSection client:visible />
    <HealthConnectSection client:visible />
    <PrivacyPolicy client:visible />
    <FAQ client:visible />
    <AppShowcase client:visible />
  </main>
  <Footer />
</Layout>

