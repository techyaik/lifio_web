---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import PrivacySecurity from '../components/PrivacySecurity.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Lifio — Master your day, health, and wealth in one calm place" 
  description="The simple, all-in-one personal tracker for Android. Track your daily steps and health, build positive habits, write personal notes, and manage your budget with 100% privacy."
>
  <Navbar />
  
  <main class="flex-1">
    <Hero />
    <FeatureGrid />
    <WhyChooseUs />
    <PrivacySecurity />
  </main>
  
  <Footer />
</Layout>
