---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import PrivacySecurity from '../components/PrivacySecurity.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Lifio — Master your day, your health, and your wealth in one quiet place" 
  description="All-in-one personal tracking mobile app for Android. Track daily vitals via Google Health Connect, log spending, write reflections, and build habit streaks with 100% offline privacy."
>
  <Navbar />
  
  <main class="flex-1">
    <Hero />
    <FeatureGrid />
    <WhyChooseUs />
    <PrivacySecurity />
  </main>
  
  <Footer />
</Layout>
