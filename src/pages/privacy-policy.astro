---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.tsx';
import { 
  ShieldCheck, 
  HeartPulse, 
  Wallet, 
  FileText, 
  CalendarCheck, 
  CheckCircle2, 
  Mail, 
  Database
} from 'lucide-react';
---

<Layout 
  title="Privacy & Data Security Policy | Lifio Mobile App" 
  description="Lifio Privacy Policy. Learn how your Health metrics, Habits checklists, Wallet Expense Tracker, and Personal Notes stay 100% private locally on your smartphone."
>
  <Navbar client:load />

  <main class="py-8 sm:py-12 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Page Header */}
      <div class="mb-8 text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200 text-xs font-bold text-emerald-700 shadow-sm mb-3">
          <ShieldCheck className="w-3.5 h-3.5 text-emerald-600" aria-hidden="true" />
          <span>LOCAL-FIRST PRIVACY GUARANTEE</span>
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight font-heading mb-2 leading-tight">
          Privacy & Data Security Policy
        </h1>
        
        <p class="text-slate-500 text-xs sm:text-sm font-medium">
          Effective Date: September 17, 2026 • Applies to Lifio Mobile Application for Android
        </p>
      </div>

      {/* Top 4 Privacy Feature Highlight Cards Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5 mb-8">
        
        {/* Module 01: Health */}
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-3">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center">
                <HeartPulse className="w-5 h-5 text-emerald-600" aria-hidden="true" />
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                  MODULE 01 • PHYSICAL WELLNESS
                </span>
                <span class="text-xs font-extrabold text-slate-300 font-heading">01</span>
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-900 font-heading flex items-center gap-2">
              <span>💚 Health Data Privacy</span>
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              All steps, heart rate BPM, active calories, sleep hours, weight/height logs, and cycle data stay saved 100% locally on your smartphone.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-slate-100 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" aria-hidden="true" />
              <span>100% device sandbox isolation</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" aria-hidden="true" />
              <span>Read-only Google Health Connect API</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" aria-hidden="true" />
              <span>Zero health telemetry or cloud sync</span>
            </li>
          </ul>
        </div>

        {/* Module 02: Habits */}
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-3">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center">
                <CalendarCheck className="w-5 h-5 text-blue-600" aria-hidden="true" />
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-extrabold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                  MODULE 02 • DAILY ROUTINES
                </span>
                <span class="text-xs font-extrabold text-slate-300 font-heading">02</span>
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-900 font-heading flex items-center gap-2">
              <span>🎯 Habits & Streaks Privacy</span>
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              Habit routines, daily completion checklists, and streak rings are calculated offline. No behavioral profiling or habit sync servers.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-slate-100 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-blue-600 flex-shrink-0" aria-hidden="true" />
              <span>Local Android alarm notifications</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-blue-600 flex-shrink-0" aria-hidden="true" />
              <span>Zero behavioral tracking servers</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-blue-600 flex-shrink-0" aria-hidden="true" />
              <span>100% offline streak ring calculations</span>
            </li>
          </ul>
        </div>

        {/* Module 03: Expenses */}
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-3">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-violet-50 border border-violet-100 flex items-center justify-center">
                <Wallet className="w-5 h-5 text-violet-600" aria-hidden="true" />
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-extrabold text-violet-700 bg-violet-50 border border-violet-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                  MODULE 03 • EXPENSES
                </span>
                <span class="text-xs font-extrabold text-slate-300 font-heading">03</span>
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-900 font-heading flex items-center gap-2">
              <span>💳 Expense Tracker Privacy</span>
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              Wallet balances are hidden by default. Lifio requires zero bank logins, zero card details, and zero third-party finance APIs.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-slate-100 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-violet-600 flex-shrink-0" aria-hidden="true" />
              <span>Hidden balance privacy mode active</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-violet-600 flex-shrink-0" aria-hidden="true" />
              <span>Zero bank credentials or card logins</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-violet-600 flex-shrink-0" aria-hidden="true" />
              <span>Offline multi-account transaction logs</span>
            </li>
          </ul>
        </div>

        {/* Module 04: Notes */}
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-3">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center">
                <FileText className="w-5 h-5 text-amber-600" aria-hidden="true" />
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-extrabold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                  MODULE 04 • NOTES
                </span>
                <span class="text-xs font-extrabold text-slate-300 font-heading">04</span>
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-900 font-heading flex items-center gap-2">
              <span>📝 Notes Summary Privacy</span>
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              Personal note entries, quick thoughts, and pinned ideas are encrypted locally in your device sandbox with zero cloud scrapers.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-slate-100 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-amber-600 flex-shrink-0" aria-hidden="true" />
              <span>Local fast keyword searching</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-amber-600 flex-shrink-0" aria-hidden="true" />
              <span>Zero cloud AI trainers or scrapers</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-amber-600 flex-shrink-0" aria-hidden="true" />
              <span>Encrypted device SQLite storage</span>
            </li>
          </ul>
        </div>

      </div>

      {/* Detailed Full Legal Text Container */}
      <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-8 md:p-9 shadow-sm space-y-7 max-w-4xl mx-auto">
        
        {/* Section 1: Expense Tracker & Wallet Data Privacy */}
        <section>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-heading pb-2 border-b border-slate-100 flex items-center gap-2">
            <Wallet className="w-4 h-4 text-violet-600" aria-hidden="true" />
            <span>1. Expense Tracker & Wallet Data Privacy</span>
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm mb-3">
            Lifio includes a personal <strong>Expense Tracker (Wallet)</strong> designed for private daily transaction logging. Here is how your financial privacy is protected:
          </p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm pl-1">
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-violet-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Zero Bank Connectivity:</strong> Lifio does not connect to Open Banking APIs, credit card accounts, or bank credentials.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-violet-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Private Balance Mode:</strong> Your total balance and spending amounts are hidden for privacy by default (toggleable via the eye icon).</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-violet-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Manual Account Logging:</strong> Multi-account tags (e.g., Main Account, Cash, Savings) and category tags (Food, Transport, Bills, Shopping) exist purely inside local app database files.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-violet-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>No Financial Telemetry:</strong> We cannot see, track, transmit, or sell your spending patterns or financial transactions.</span>
            </li>
          </ul>
        </section>

        {/* Section 2: Health & Fitness Data Privacy */}
        <section>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-heading pb-2 border-b border-slate-100 flex items-center gap-2">
            <HeartPulse className="w-4 h-4 text-emerald-600" aria-hidden="true" />
            <span>2. Health & Fitness Data Privacy</span>
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm mb-3">
            Lifio’s <strong>Track Your Health</strong> module acts as a completely private, offline logbook for all your physical wellness metrics. Here is how every health category is protected:
          </p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm pl-1">
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Movement & Activity Vitals:</strong> Daily step counts, active distance (km/mi), active calories burned (kcal), and exercise activity minutes stay stored strictly inside your phone’s local database sandbox.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Rest & Sleep Stage Analysis:</strong> Sleep duration tracking (hours), sleep quality scores (0–100), and stage breakdowns (Deep, Light, REM, Awake) stay 100% offline on device memory.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Heart Rate & Blood Oxygen Metrics:</strong> Resting and continuous heart rate logs (BPM) as well as Blood Oxygen saturation levels (SpO2 %) are kept private with zero cloud transmission or medical telemetry.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Body Composition Records:</strong> Weight history (kg/lbs), height records (cm/ft), and body fat percentage logs remain on your device without upload to fitness cloud platforms.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Cycle & Reproductive Health Tracking:</strong> Cycle logs (last period date, cycle length, period duration, flow intensity, and symptoms) are disabled by default. When enabled, period reminders schedule locally via Android alarms with zero cloud analytics or remote tracking servers.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Hydration & Medicine Reminders:</strong> Daily water intake logs (glasses/liters) and medication reminder schedules operate offline without sending health logs over the network.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Read-Only Google Health Connect Sync:</strong> When you connect Google Health Connect, Lifio reads health data directly on your device via Android native APIs. Lifio does not send your synced Health Connect data to any external server or third party.</span>
            </li>
          </ul>
        </section>

        {/* Section 3: Habits Checklists & Streak Data Privacy */}
        <section>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-heading pb-2 border-b border-slate-100 flex items-center gap-2">
            <CalendarCheck className="w-4 h-4 text-blue-600" aria-hidden="true" />
            <span>3. Habits Checklists & Streak Data Privacy</span>
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm mb-3">
            Lifio’s <strong>Build Better Habits</strong> module empowers you to build routines with complete peace of mind:
          </p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm pl-1">
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Local Habit Database:</strong> Daily habit routines, custom habit names, target frequency (daily, weekly), and check-off logs are stored exclusively in your device database.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Offline Streak Calculation:</strong> Streak counters, milestone rings, and weekly progress percentages are calculated on-device without telemetry.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Local Device Notifications:</strong> Custom habit reminders schedule through local Android system alarms. No external push messaging servers access your habit schedules or titles.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Zero Behavioral Tracking:</strong> Lifio does not track how often you succeed or skip a habit, nor do we build behavioral profiles or monetize your habit data.</span>
            </li>
          </ul>
        </section>

        {/* Section 4: Personal Notes & Notepad Data Privacy */}
        <section>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-heading pb-2 border-b border-slate-100 flex items-center gap-2">
            <FileText className="w-4 h-4 text-amber-600" aria-hidden="true" />
            <span>4. Personal Notes & Notepad Data Privacy</span>
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm mb-3">
            Lifio’s <strong>Capture Your Notes</strong> module provides a fast, offline notepad for your thoughts and ideas:
          </p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm pl-1">
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Encrypted Device Sandbox:</strong> Note titles, body text, tags, and pinned dashboard items reside directly inside your app sandbox storage.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>No Cloud Sync or Remote Crawling:</strong> Your private notes are never uploaded to cloud servers, external databases, or third-party AI model trainers.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Fast Offline Keyword Search:</strong> Keyword searching across your notes operates entirely within local phone memory, ensuring your search queries never touch the internet.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Immediate Deletion:</strong> Deleting a note permanently purges the entry from your phone’s local database file without retention on cloud backups.</span>
            </li>
          </ul>
        </section>

        {/* Section 5: Zero Account & Full Data Control */}
        <section>
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-heading pb-2 border-b border-slate-100 flex items-center gap-2">
            <Database className="w-4 h-4 text-emerald-600" aria-hidden="true" />
            <span>5. Zero Account & Full Data Control</span>
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm mb-3">
            Lifio is built from the ground up on a <strong>local-first, accountless architecture</strong>. You retain absolute ownership of all your data:
          </p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm pl-1">
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>No Account Registration:</strong> Lifio never asks for an email address, phone number, password, or social sign-in (Google, Facebook, Apple). You launch the app and start tracking immediately.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Strict Android Sandbox Isolation:</strong> All SQLite database files reside exclusively inside your Android app sandbox storage. No remote servers or external apps have access to your data.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Zero Tracking SDKs & Ad Networks:</strong> Lifio does not embed invasive telemetry, advertising SDKs (e.g. Google AdMob, Meta Ads), or behavior tracking frameworks.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Instant Permanent Deletion:</strong> Uninstalling Lifio or selecting "Clear Storage / Clear Data" in your Android system settings instantly and permanently deletes 100% of your database records with zero residual cloud traces.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>User-Controlled Local Backups:</strong> Any manual data exports (JSON or CSV) remain strictly in your control to save locally on your device storage or personal backup drive.</span>
            </li>
          </ul>
        </section>

        {/* Section 6: Contact Information & Support */}
        <section class="pt-5 border-t border-slate-100">
          <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-3 font-heading">
            6. Contact Information, Support & Policy Transparency
          </h2>
          <p class="text-slate-600 leading-relaxed text-xs sm:text-sm mb-3">
            We believe in direct, transparent communication. If you have questions regarding offline data security, bug reports, feature requests, or privacy guarantees across Health, Habits, Expense Tracking, or Notes:
          </p>
          <ul class="space-y-2 text-slate-600 text-xs sm:text-sm mb-5 pl-1">
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Direct Developer Contact:</strong> You can contact the creator of Lifio directly via email at <a href="mailto:imran@idexa.app" class="text-emerald-600 font-bold hover:underline">imran@idexa.app</a>.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Responsive SLA:</strong> All support tickets and privacy inquiries are answered personally within 24 to 48 business hours.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Zero Spam Guarantee:</strong> When you email support, your contact details are strictly used to address your request. We never add support emails to marketing newsletters or sell contact lists.</span>
            </li>
            <li class="flex items-start gap-2">
              <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong>Policy Update Transparency:</strong> Any future adjustments to this Privacy Policy will be published directly on this URL with an updated "Effective Date" banner.</span>
            </li>
          </ul>

          <div class="p-5 bg-slate-900 rounded-xl text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-md">
            <div>
              <span class="text-[10px] font-bold tracking-wider text-emerald-400 uppercase block mb-0.5">
                Official Developer Support Contact
              </span>
              <a 
                href="mailto:imran@idexa.app" 
                class="text-base sm:text-lg font-extrabold hover:text-emerald-400 transition-colors inline-flex items-center gap-2"
              >
                <Mail className="w-4 h-4 text-emerald-400" aria-hidden="true" />
                <span>imran@idexa.app</span>
              </a>
              <p class="text-slate-400 text-[11px] mt-0.5 font-normal">
                Guaranteed response within 24 to 48 business hours.
              </p>
            </div>
            
            <a 
              href="mailto:imran@idexa.app"
