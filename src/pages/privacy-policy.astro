---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { 
  ShieldCheck, 
  HeartPulse, 
  Wallet, 
  FileText, 
  CalendarCheck, 
  Check, 
  Mail, 
  Database
} from 'lucide-react';
---

<Layout 
  title="Privacy & Data Security Policy | Lifio Mobile App" 
  description="Lifio Privacy Policy. Learn how your Health vitals, Habits, Expenses, and Personal Notes stay 100% private locally inside your device database."
  canonicalURL="https://lifio.app/privacy"
>
  <Navbar />

  <main class="py-12 sm:py-20 bg-[#F0EFEB] min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {/* Page Header */}
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white border border-[#E5E2DC] text-xs font-semibold text-[#171717]">
          <ShieldCheck className="w-3.5 h-3.5 text-[#FFBB2C]" aria-hidden="true" />
          <span class="tracking-wider uppercase text-[11px] font-semibold text-[#5F5C57]">Local-First Privacy Sanctuary</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold text-[#171717] tracking-tight leading-tight">
          Privacy & Data Security Policy
        </h1>
        
        <p class="text-[#858174] text-xs sm:text-sm font-normal">
          Effective Date: September 17, 2026 • Applies to Lifio Mobile Application for Android
        </p>
      </div>

      {/* Top 4 Privacy Highlight Cards Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        {/* Module 01: Health */}
        <div class="bg-white p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] flex flex-col justify-between space-y-5">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] flex items-center justify-center text-[#FFBB2C]">
                <HeartPulse className="w-5 h-5 stroke-[2]" aria-hidden="true" />
              </div>
              <span class="text-[11px] font-semibold text-[#5F5C57] bg-[#F0EFEB] border border-[#E5E2DC] px-3 py-1 rounded-lg uppercase tracking-wider">
                Module 01 • Health
              </span>
            </div>

            <h3 class="text-lg font-semibold text-[#171717]">
              Health Data Privacy
            </h3>

            <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
              All steps, heart rate BPM, sleep hours, and vitals stay saved 100% locally on your smartphone with read-only Google Health Connect access.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-[#E5E2DC] text-xs text-[#171717] font-medium">
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>100% device sandbox isolation</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Read-only Google Health Connect API</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Zero biometric cloud telemetry</span>
            </li>
          </ul>
        </div>

        {/* Module 02: Habits */}
        <div class="bg-white p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] flex flex-col justify-between space-y-5">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] flex items-center justify-center text-[#FFBB2C]">
                <CalendarCheck className="w-5 h-5 stroke-[2]" aria-hidden="true" />
              </div>
              <span class="text-[11px] font-semibold text-[#5F5C57] bg-[#F0EFEB] border border-[#E5E2DC] px-3 py-1 rounded-lg uppercase tracking-wider">
                Module 02 • Habits
              </span>
            </div>

            <h3 class="text-lg font-semibold text-[#171717]">
              Habits & Streaks Privacy
            </h3>

            <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
              Habit routines, daily completion logs, and streak counters are calculated entirely offline without behavioral profiling or tracking servers.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-[#E5E2DC] text-xs text-[#171717] font-medium">
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Local Android alarm notifications</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Zero behavioral profiling servers</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>100% offline streak calculations</span>
            </li>
          </ul>
        </div>

        {/* Module 03: Notes */}
        <div class="bg-white p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] flex flex-col justify-between space-y-5">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] flex items-center justify-center text-[#FFBB2C]">
                <FileText className="w-5 h-5 stroke-[2]" aria-hidden="true" />
              </div>
              <span class="text-[11px] font-semibold text-[#5F5C57] bg-[#F0EFEB] border border-[#E5E2DC] px-3 py-1 rounded-lg uppercase tracking-wider">
                Module 03 • Notes
              </span>
            </div>

            <h3 class="text-lg font-semibold text-[#171717]">
              Personal Notes Privacy
            </h3>

            <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
              Reflections, ideas, and checklists are stored in your encrypted local database sandbox. Zero cloud scrapers or AI model training.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-[#E5E2DC] text-xs text-[#171717] font-medium">
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Fast local keyword search in memory</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Zero AI cloud scraping or training</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Encrypted device SQLite storage</span>
            </li>
          </ul>
        </div>

        {/* Module 04: Expenses */}
        <div class="bg-white p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] flex flex-col justify-between space-y-5">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] flex items-center justify-center text-[#FFBB2C]">
                <Wallet className="w-5 h-5 stroke-[2]" aria-hidden="true" />
              </div>
              <span class="text-[11px] font-semibold text-[#5F5C57] bg-[#F0EFEB] border border-[#E5E2DC] px-3 py-1 rounded-lg uppercase tracking-wider">
                Module 04 • Expenses
              </span>
            </div>

            <h3 class="text-lg font-semibold text-[#171717]">
              Expense & Wallet Privacy
            </h3>

            <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
              Balances are hidden by default. Lifio requires zero bank logins, zero card details, and zero third-party finance aggregators.
            </p>
          </div>

          <ul class="space-y-2 pt-3 border-t border-[#E5E2DC] text-xs text-[#171717] font-medium">
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Hidden balance privacy mode active</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>Zero bank credentials or card logins</span>
            </li>
            <li class="flex items-center gap-2">
              <Check className="w-3.5 h-3.5 text-[#FFBB2C] stroke-[2.5]" aria-hidden="true" />
              <span>100% offline transaction records</span>
            </li>
          </ul>
        </div>

      </div>

      {/* Detailed Full Legal Text Container in Pure White */}
      <div class="bg-white rounded-[24px] border border-[#E5E2DC] p-7 sm:p-12 space-y-8 max-w-4xl mx-auto">
        
        {/* Section 1: Expense Tracker */}
        <section>
          <h2 class="text-base sm:text-lg font-semibold text-[#171717] mb-3 pb-2 border-b border-[#E5E2DC] flex items-center gap-2">
            <Wallet className="w-4 h-4 text-[#FFBB2C]" aria-hidden="true" />
            <span>1. Expense Tracker & Wallet Data Privacy</span>
          </h2>
          <p class="text-[#5F5C57] leading-relaxed text-sm mb-3 font-normal">
            Lifio includes a personal <strong class="font-medium text-[#171717]">Expense Tracker (Wallet)</strong> designed for private daily transaction logging. Here is how your financial privacy is protected:
          </p>
          <ul class="space-y-2.5 text-[#5F5C57] text-sm pl-1 font-normal">
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Zero Bank Connectivity:</strong> Lifio does not connect to Open Banking APIs, credit card accounts, or bank credentials.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Private Balance Mode:</strong> Your total balance and spending amounts are hidden for privacy by default.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Manual Account Logging:</strong> Multi-account tags and category tags exist purely inside local app database files.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">No Financial Telemetry:</strong> We cannot see, track, transmit, or sell your spending patterns or financial transactions.</span>
            </li>
          </ul>
        </section>

        {/* Section 2: Health & Fitness */}
        <section>
          <h2 class="text-base sm:text-lg font-semibold text-[#171717] mb-3 pb-2 border-b border-[#E5E2DC] flex items-center gap-2">
            <HeartPulse className="w-4 h-4 text-[#FFBB2C]" aria-hidden="true" />
            <span>2. Health & Fitness Data Privacy</span>
          </h2>
          <p class="text-[#5F5C57] leading-relaxed text-sm mb-3 font-normal">
            Lifio’s <strong class="font-medium text-[#171717]">Track Your Health</strong> module acts as a completely private, offline logbook for all your physical wellness metrics:
          </p>
          <ul class="space-y-2.5 text-[#5F5C57] text-sm pl-1 font-normal">
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Movement & Activity Vitals:</strong> Daily steps, active distance, calories burned, and activity minutes stay stored strictly inside your local database sandbox.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Rest & Sleep Analysis:</strong> Sleep duration tracking and stage breakdowns stay 100% offline on device memory.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Read-Only Google Health Connect:</strong> Lifio reads health data directly on your device via Android native APIs without ever uploading to an external server.</span>
            </li>
          </ul>
        </section>

        {/* Section 3: Habits */}
        <section>
          <h2 class="text-base sm:text-lg font-semibold text-[#171717] mb-3 pb-2 border-b border-[#E5E2DC] flex items-center gap-2">
            <CalendarCheck className="w-4 h-4 text-[#FFBB2C]" aria-hidden="true" />
            <span>3. Habits Checklists & Streak Data Privacy</span>
          </h2>
          <p class="text-[#5F5C57] leading-relaxed text-sm mb-3 font-normal">
            Lifio’s <strong class="font-medium text-[#171717]">Build Better Habits</strong> module empowers you to build routines with complete peace of mind:
          </p>
          <ul class="space-y-2.5 text-[#5F5C57] text-sm pl-1 font-normal">
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Local Habit Database:</strong> Daily routines, custom names, target frequency, and check-offs are stored exclusively in your device database.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Offline Streak Calculation:</strong> Streak counters and milestone rings are calculated on-device without telemetry.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Local Android Alarms:</strong> Custom habit reminders schedule through local Android system alarms. No external push messaging servers access your habits.</span>
            </li>
          </ul>
        </section>

        {/* Section 4: Notes */}
        <section>
          <h2 class="text-base sm:text-lg font-semibold text-[#171717] mb-3 pb-2 border-b border-[#E5E2DC] flex items-center gap-2">
            <FileText className="w-4 h-4 text-[#FFBB2C]" aria-hidden="true" />
            <span>4. Personal Notes & Thought Organization</span>
          </h2>
          <p class="text-[#5F5C57] leading-relaxed text-sm mb-3 font-normal">
            Lifio’s <strong class="font-medium text-[#171717]">Capture Your Notes</strong> module provides a fast, offline notepad for your thoughts and ideas:
          </p>
          <ul class="space-y-2.5 text-[#5F5C57] text-sm pl-1 font-normal">
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Encrypted Device Sandbox:</strong> Note titles, body text, tags, and pinned items reside directly inside your app sandbox storage.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Zero AI Cloud Scraping:</strong> Your private notes are never uploaded to cloud servers or AI model trainers.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Fast Offline Keyword Search:</strong> Keyword searching across your notes operates entirely within local phone memory.</span>
            </li>
          </ul>
        </section>

        {/* Section 5: Zero Account & Full Control */}
        <section>
          <h2 class="text-base sm:text-lg font-semibold text-[#171717] mb-3 pb-2 border-b border-[#E5E2DC] flex items-center gap-2">
            <Database className="w-4 h-4 text-[#FFBB2C]" aria-hidden="true" />
            <span>5. Zero Account & Full Data Control</span>
          </h2>
          <p class="text-[#5F5C57] leading-relaxed text-sm mb-3 font-normal">
            Lifio is built on an <strong class="font-medium text-[#171717]">accountless, local-first architecture</strong>. You retain absolute ownership:
          </p>
          <ul class="space-y-2.5 text-[#5F5C57] text-sm pl-1 font-normal">
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">No Registration:</strong> Lifio never asks for email, phone number, or password. Launch the app and start tracking immediately.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Zero Tracking SDKs:</strong> Lifio does not embed advertising SDKs (no Google AdMob, Meta Ads) or behavior trackers.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-4 h-4 text-[#FFBB2C] stroke-[2.5] flex-shrink-0 mt-0.5" aria-hidden="true" />
              <span><strong class="font-medium text-[#171717]">Instant Permanent Deletion:</strong> Uninstalling the app instantly purges 100% of your database records with zero cloud traces.</span>
            </li>
          </ul>
        </section>

        {/* Section 6: Contact Information */}
        <section class="pt-6 border-t border-[#E5E2DC]">
          <h2 class="text-base sm:text-lg font-semibold text-[#171717] mb-3">
            6. Direct Developer Support & Transparency
          </h2>
          <p class="text-[#5F5C57] leading-relaxed text-sm mb-5 font-normal">
            If you have questions regarding offline data security, bug reports, or feature suggestions:
          </p>

          <div class="p-6 sm:p-8 bg-[#F0EFEB] rounded-[20px] border border-[#E5E2DC] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <span class="text-[10px] font-medium tracking-wider text-[#858174] uppercase block">
                Official Developer Support Contact
              </span>
              <a 
                href="mailto:imran@idexa.app" 
                class="text-base sm:text-lg font-semibold text-[#171717] hover:text-[#FFBB2C] transition-colors inline-flex items-center gap-2"
              >
                <Mail className="w-4 h-4 text-[#FFBB2C]" aria-hidden="true" />
                <span>imran@idexa.app</span>
              </a>
              <p class="text-[#858174] text-xs font-normal">
                Guaranteed personal response within 24 to 48 business hours.
              </p>
            </div>
            
            <a 
              href="mailto:imran@idexa.app"
              class="inline-flex items-center justify-center bg-[#FFBB2C] hover:bg-[#f0ad24] text-[#171717] font-semibold px-5 py-2.5 rounded-xl text-xs transition-all shadow-sm"
            >
              Send Email
            </a>
          </div>
        </section>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
