---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Mail, MessageSquare, Bug, HelpCircle, Sparkles, CheckCircle2 } from 'lucide-react';
---

<Layout 
  title="Contact & Support | Lifio Mobile App" 
  description="Contact direct developer support for Lifio personal tracker mobile application. Prompt, personal assistance at imran@idexa.app."
>
  <Navbar />

  <main class="py-12 sm:py-20 bg-[#F0EFEB] min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      {/* Header */}
      <div class="text-center space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white border border-[#E5E2DC] text-xs font-semibold text-[#171717]">
          <Sparkles className="w-3.5 h-3.5 text-[#FFBB2C]" />
          <span class="tracking-wider uppercase text-[11px] font-semibold text-[#5F5C57]">Direct Developer Support</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-semibold text-[#171717] tracking-tight">
          Contact & Support
        </h1>

        <p class="text-sm sm:text-base text-[#5F5C57] font-normal leading-relaxed max-w-xl mx-auto">
          Have questions, feedback, or need help with Lifio? Reach out directly to the developer for personal assistance.
        </p>
      </div>

      {/* Main Support Email Card */}
      <div class="bg-white rounded-[24px] p-7 sm:p-10 border border-[#E5E2DC] space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-[#E5E2DC]">
          <div class="space-y-1">
            <span class="text-[11px] font-medium uppercase tracking-wider text-[#858174]">Official Support Email</span>
            <a 
              href="mailto:imran@idexa.app" 
              class="text-xl sm:text-2xl font-semibold text-[#171717] hover:text-[#FFBB2C] transition-colors flex items-center gap-2"
            >
              <Mail className="w-5 h-5 text-[#FFBB2C]" />
              <span>imran@idexa.app</span>
            </a>
          </div>

          <a 
            href="mailto:imran@idexa.app" 
            class="inline-flex items-center justify-center gap-2 bg-[#FFBB2C] hover:bg-[#f0ad24] text-[#171717] font-semibold px-6 py-3 rounded-xl text-sm shadow-sm transition-all flex-shrink-0"
          >
            <span>Send Direct Email</span>
          </a>
        </div>

        <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
          All inquiries are handled personally by the lead developer of Lifio. You can expect a response within 24 to 48 business hours.
        </p>

        {/* Support Categories */}
        <div class="pt-2">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-[#171717] mb-4">
            How Can We Help You?
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            <div class="p-4 rounded-2xl bg-[#FAF9F7] border border-[#E5E2DC] space-y-1.5">
              <div class="w-8 h-8 rounded-xl bg-white text-[#FFBB2C] flex items-center justify-center border border-[#E5E2DC]">
                <Bug className="w-4 h-4" />
              </div>
              <h3 class="text-xs font-medium text-[#171717]">Bug Reports</h3>
              <p class="text-[11px] font-normal text-[#5F5C57]">Report unexpected crashes or display bugs.</p>
            </div>

            <div class="p-4 rounded-2xl bg-[#FAF9F7] border border-[#E5E2DC] space-y-1.5">
              <div class="w-8 h-8 rounded-xl bg-white text-[#FFBB2C] flex items-center justify-center border border-[#E5E2DC]">
                <HelpCircle className="w-4 h-4" />
              </div>
              <h3 class="text-xs font-medium text-[#171717]">Health Connect</h3>
              <p class="text-[11px] font-normal text-[#5F5C57]">Help linking Android Health Connect vitals.</p>
            </div>

            <div class="p-4 rounded-2xl bg-[#FAF9F7] border border-[#E5E2DC] space-y-1.5">
              <div class="w-8 h-8 rounded-xl bg-white text-[#FFBB2C] flex items-center justify-center border border-[#E5E2DC]">
                <MessageSquare className="w-4 h-4" />
              </div>
              <h3 class="text-xs font-medium text-[#171717]">Feature Ideas</h3>
              <p class="text-[11px] font-normal text-[#5F5C57]">Suggest new tools or workflow enhancements.</p>
            </div>
          </div>
        </div>

        {/* SLA & Guarantee */}
        <div class="pt-4 border-t border-[#E5E2DC] flex flex-wrap items-center gap-5 text-xs font-medium text-[#5F5C57]">
          <div class="flex items-center gap-1.5">
            <CheckCircle2 className="w-3.5 h-3.5 text-[#8DAF2B]" />
            <span>24–48h Response SLA</span>
          </div>
          <div class="flex items-center gap-1.5">
            <CheckCircle2 className="w-3.5 h-3.5 text-[#8DAF2B]" />
            <span>Zero Marketing Spam</span>
          </div>
          <div class="flex items-center gap-1.5">
            <CheckCircle2 className="w-3.5 h-3.5 text-[#8DAF2B]" />
            <span>Direct Developer Contact</span>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
