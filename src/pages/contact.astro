---
import Icon from '@/components/icons/icon.astro';
import Container from '@/components/ui/container.astro';
import SectionHeading from '@/components/ui/section-heading.astro';
import ToneBadge from '@/components/ui/tone-badge.astro';
import { site } from '@/config/site';
import type { IconName } from '@/components/icons/icon-glyphs';
import type { Tone } from '@/data/tones';
import BaseLayout from '@/layouts/base-layout.astro';

const mailto = (subject: string) => `mailto:${site.supportEmail}?subject=${encodeURIComponent(subject)}`;

interface Topic {
  readonly icon: IconName;
  readonly tone: Tone;
  readonly title: string;
  readonly body: string;
  readonly subject: string;
}

const topics: readonly Topic[] = [
  {
    icon: 'bug',
    tone: 'pink',
    title: 'Something isn’t working',
    body: 'Tell us what you did and what happened. Your phone model and Android version help. Please don’t send your data.',
    subject: 'Lifio: something isn’t working',
  },
  {
    icon: 'reminders',
    tone: 'amber',
    title: 'Reminders arrive late',
    body: 'First try Settings → Notifications → “Are my reminders reliable?” in the app. Still stuck? Write to us.',
    subject: 'Lifio: reminders',
  },
  {
    icon: 'backup',
    tone: 'mint',
    title: 'Backup and restore',
    body: 'Moving to a new phone or restoring a file. We can’t see your data, but we can walk you through it.',
    subject: 'Lifio: backup and restore',
  },
  {
    icon: 'idea',
    tone: 'sky',
    title: 'An idea',
    body: 'Something that would make Lifio more useful for your day. Check the roadmap to see what’s already planned.',
    subject: 'An idea for Lifio',
  },
];
---

<BaseLayout title="Support" description={`Get help with Lifio, report a problem or share an idea. Write to ${site.supportEmail}; a person reads every message.`}>
  <section class="pt-14 pb-20 sm:pt-20 sm:pb-28">
    <Container class="flex flex-col gap-12">
      <SectionHeading as="h1" eyebrow="Support" title="We’re here to help." lead="Questions, problems or ideas: write to us, and a person reads every message." />

      <div class="bg-hero relative flex flex-col gap-6 overflow-hidden rounded-hero px-6 py-10 text-white sm:flex-row sm:items-center sm:justify-between sm:px-12 sm:py-12">
        <span class="pointer-events-none absolute -top-24 -right-16 size-72 rounded-full bg-white/10" aria-hidden="true"></span>
        <div class="relative flex flex-col gap-1.5">
          <p class="text-[13px] font-semibold tracking-[0.1em] text-white/80 uppercase">Email</p>
          <a href={`mailto:${site.supportEmail}`} class="text-2xl font-bold tracking-[-0.02em] break-all hover:underline sm:text-3xl">{site.supportEmail}</a>
        </div>
        <a
          href={`mailto:${site.supportEmail}`}
          class="relative inline-flex h-13 shrink-0 items-center gap-2.5 self-start rounded-full bg-white px-6 font-semibold text-[#0A0A0B] hover:bg-white/90 sm:self-auto"
        >
          <Icon name="email" size={20} />
          Write to us
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          topics.map((topic) => (
            <a href={mailto(topic.subject)} class="group flex flex-col gap-4 rounded-card bg-surface p-6 transition-colors hover:bg-chrome sm:p-7">
              <div class="flex items-center justify-between">
                <ToneBadge icon={topic.icon} tone={topic.tone} />
                <span class="flex size-9 items-center justify-center rounded-full bg-sunken text-ink-2 transition-colors group-hover:text-ink">
                  <Icon name="arrow-up-right" size={18} />
                </span>
              </div>
              <h2 class="text-lg font-bold text-ink">{topic.title}</h2>
              <p class="leading-relaxed text-ink-2">{topic.body}</p>
            </a>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 rounded-card bg-surface p-6 sm:flex-row sm:items-center sm:gap-5 sm:p-7">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-[16px] bg-sunken text-ink">
          <Icon name="privacy" size={24} />
        </span>
        <p class="leading-relaxed text-ink-2">
          <strong class="font-semibold text-ink">We can’t see your data</strong>, so we can’t look anything up or recover it. That’s the point. There’s no
          need to send us a backup file or your personal entries.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
