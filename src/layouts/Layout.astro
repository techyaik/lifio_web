---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title = "Lifio — Master your day, health, and wealth in one calm place",
  description = "A quiet, 100% offline personal tracker for Android. Manage physical wellness via Health Connect, habit streaks, mindful thoughts, and multi-wallet budgets with zero account requirements.",
  image = "/lifio-icon.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://lifio.app').href,
  noindex = false,
} = Astro.props;

const siteName = "Lifio";
const siteUrl = "https://lifio.app";
const resolvedImage = new URL(image, Astro.site ?? siteUrl).href;

// Schema.org JSON-LD Structured Data with @graph for WebSite & SoftwareApplication
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": siteName,
      "description": "A quiet, 100% offline personal tracker for Android.",
      "inLanguage": "en-US"
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      "name": siteName,
      "operatingSystem": "Android",
      "applicationCategory": "HealthApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "featureList": [
        "Google Health Connect Physical Wellness Sync",
        "Habit Streaks & Milestone Rings",
        "Mindful Notes & Reflection Journal",
        "Multi-Account Wallet & Expense Budgets",
        "100% Offline SQLite Sandbox Privacy"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalURL} />

    {/* Favicon & App Icons */}
    <link rel="icon" type="image/png" href="/lifio-icon.png" />
    <link rel="apple-touch-icon" href="/lifio-icon.png" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content="Lifio App Logo" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content="Lifio App Logo" />

    {/* Theme & Design Aesthetics */}
    <meta name="theme-color" content="#F0EFEB" />
    <meta name="color-scheme" content="light" />

    {/* Structured Data (Schema.org JSON-LD) */}
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-[#F0EFEB] text-[#171717] antialiased selection:bg-[#FFBB2C]/30 selection:text-[#171717] min-h-screen flex flex-col">
    <slot />
  </body>
</html>
