---
import { Image } from 'astro:assets';

import type { Screen } from '@/data/screens';

/** A real Lifio screenshot in a plain phone frame. */
interface Props {
  readonly screen: Screen;
  /** Rendered width in CSS pixels; the image is generated at 1× and 2×. */
  readonly width?: number;
  /** The hero image loads straight away; the rest wait until they scroll into view. */
  readonly priority?: boolean;
  readonly class?: string;
}

const { screen, width = 300, priority = false, class: className = '' } = Astro.props;
// A modest screen radius, so the app's own content isn't clipped at the corners; the frame's
// radius is the screen's plus the bezel, so both curves stay parallel.
const bezel = Math.round(width * 0.03);
const screenRadius = Math.round(width * 0.055);
const frameRadius = screenRadius + bezel;
---

<div class:list={['shrink-0 bg-[#0A0A0B] ring-1 ring-line', className]} style={`width:${width}px;padding:${bezel}px;border-radius:${frameRadius}px`}>
  <Image
    src={screen.image}
    alt={screen.alt}
    width={width - 2 * bezel}
    densities={[1, 2]}
    format="webp"
    quality={85}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="block h-auto w-full bg-white"
    style={`border-radius:${screenRadius}px`}
  />
</div>
