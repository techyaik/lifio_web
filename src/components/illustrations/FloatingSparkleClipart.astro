---
interface Props {
  class?: string;
  color?: string;
}
const { class: className = "w-8 h-8", color = "#FFBB2C" } = Astro.props;
---
<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
  <path d="M20 4 L20 36 M4 20 L36 20" stroke={color} stroke-width="2.5" stroke-linecap="round" />
  <circle cx="20" cy="20" r="2.5" fill={color} />
</svg>

