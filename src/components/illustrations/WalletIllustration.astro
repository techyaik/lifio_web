  <path d="M78 140 C78 108, 86 96, 120 96 C154 96, 162 108, 162 140 Z" fill="#805044" />
  <path d="M84 136 C84 112, 92 104, 120 104 C148 104, 156 112, 156 136" stroke="#D8CBB8" stroke-width="1.5" stroke-dasharray="3 3" fill="none" />

  <g transform="translate(120, 68)">
    <circle cx="0" cy="0" r="26" fill="#FFBB2C" />
    <circle cx="0" cy="0" r="21" stroke="#E9A51B" stroke-width="2" stroke-dasharray="3 2" />
