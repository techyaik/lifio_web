    <ellipse cx="-34" cy="-25" rx="6" ry="3" transform="rotate(-45 -34 -25)" fill="#749222" />

    <path d="M44 18 C52 -8, 40 -30, 18 -44" stroke="#8DAF2B" stroke-width="2.5" stroke-linecap="round" />
