  <circle cx="120" cy="80" r="52" fill="#DCD7F4" fill-opacity="0.35" />
  <ellipse cx="120" cy="142" rx="50" ry="6" fill="#805044" fill-opacity="0.12" />

  <g transform="translate(120, 80)">
    <path d="M-44 18 C-52 -8, -40 -30, -18 -44" stroke="#8DAF2B" stroke-width="2.5" stroke-linecap="round" />
