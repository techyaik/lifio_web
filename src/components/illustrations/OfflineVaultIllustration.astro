    <circle cx="-8" cy="7" r="2" fill="#171717" />
    <circle cx="8" cy="7" r="2" fill="#171717" />
    <path d="M0 20 C-3 17, -5 14, -5 11 C-5 9, -3.5 8, -2 8 C-1 8, 0 9, 0 9 C0 9, 1 8, 2 8 C3.5 8, 5 9, 5 11 C5 14, 3 17, 0 20 Z" fill="#805044" />
