---
import HealthIllustration from './illustrations/HealthIllustration.astro';
import HabitsIllustration from './illustrations/HabitsIllustration.astro';
import NotesIllustration from './illustrations/NotesIllustration.astro';
import WalletIllustration from './illustrations/WalletIllustration.astro';
import OfflineVaultIllustration from './illustrations/OfflineVaultIllustration.astro';
import DailyClarityIllustration from './illustrations/DailyClarityIllustration.astro';

interface FeatureItem {
  module: string;
  tag: string;
  tagBg: string;
  tagDot: string;
  title: string;
  desc: string;
  component: typeof HealthIllustration;
  chips: string[];
}

const features: FeatureItem[] = [
  {
    module: '01 / Health',
    tag: 'Wellness',
    tagBg: 'bg-[#F5F8EF]',
    tagDot: 'bg-[#8DAF2B]',
    title: 'Health & Daily Wellness',
    desc: 'Keep track of your daily steps, sleep quality, and heart rate with ease. All your health data stays private on your phone.',
    component: HealthIllustration,
    chips: ['Daily Steps', 'Sleep Tracking', 'Heart Rate']
  },
  {
    module: '02 / Habits',
    tag: 'Streaks',
    tagBg: 'bg-[#FAF7ED]',
    tagDot: 'bg-[#FFBB2C]',
    title: 'Habits & Routines',
    desc: 'Build positive daily habits step by step. Check off routines, watch your streaks grow, and get gentle reminders when you need them.',
    component: HabitsIllustration,
    chips: ['Daily Checklists', 'Streak Counter', 'Gentle Reminders']
  },
  {
    module: '03 / Notes',
    tag: 'Journal',
    tagBg: 'bg-[#F7F5FA]',
    tagDot: 'bg-[#DCD7F4]',
    title: 'Journal & Quick Notes',
    desc: 'A quiet space to write down your thoughts, morning reflections, and daily to-do lists. Find anything you wrote in a snap.',
    component: NotesIllustration,
    chips: ['Quick Ideas', 'Morning Thoughts', 'Instant Search']
  },
  {
    module: '04 / Expenses',
    tag: 'Budget',
    tagBg: 'bg-[#FAF5F7]',
    tagDot: 'bg-[#805044]',
    title: 'Money & Spending',
    desc: 'Know exactly where your money goes every day. Set category budgets and track your spending simply—no bank logins needed.',
    component: WalletIllustration,
    chips: ['Daily Spending', 'Category Limits', 'No Bank Logins']
  },
  {
    module: '05 / Privacy',
    tag: 'Private',
    tagBg: 'bg-[#F5F8EF]',
    tagDot: 'bg-[#8DAF2B]',
    title: 'Always Private & Offline',
    desc: 'Start using the app right away. No sign-ups, no passwords to remember, and no cloud servers storing your personal life.',
    component: OfflineVaultIllustration,
    chips: ['No Signup Needed', 'Zero Ads', '100% On-Device']
  },
  {
    module: '06 / Clarity',
    tag: 'All-in-One',
    tagBg: 'bg-[#FAF7ED]',
    tagDot: 'bg-[#FFBB2C]',
    title: 'Everything in One Place',
    desc: 'Check your daily health, habits, notes, and spending on one peaceful screen without constantly juggling multiple apps.',
    component: DailyClarityIllustration,
    chips: ['Calm Daily View', 'No Clutter', 'Super Fast']
  }
];
---

<section id="features" class="py-20 md:py-28 bg-[#F0EFEB] border-t border-[#E5E2DC]">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
    
    {/* Section Header */}
    <div class="max-w-xl space-y-2.5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-[#FFFFFF] border border-[#E5E2DC] text-xs font-semibold text-[#171717]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FFBB2C]"></span>
        <span class="text-[#5F5C57] font-medium">Simple & Powerful</span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-bold text-[#171717] tracking-[-0.025em] leading-[1.15]">
        Everything you need for daily life, in one simple app.
      </h2>

      <p class="text-base text-[#5F5C57] font-normal leading-relaxed">
        Take care of your health, build better habits, organize your thoughts, and track your money—all in one peaceful place.
      </p>
    </div>

    {/* 1/3 * 2 = 6-Item Feature Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((item) => {
        const IllustrationComponent = item.component;
        return (
          <div class="bg-[#FFFFFF] rounded-2xl p-7 border border-[#E5E2DC] flex flex-col justify-between space-y-5 hover:border-[#D8D4CC] transition-all">
            <div class="space-y-4">
              {/* Header Row */}
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-[#858174]">{item.module}</span>
                <span class={`h-6 px-2.5 rounded-lg ${item.tagBg} text-xs font-medium text-[#171717] border border-[#E5E2DC] flex items-center gap-1.5`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${item.tagDot}`}></span>
                  {item.tag}
                </span>
              </div>

              {/* Transparent Vector Illustration */}
              <div class="py-2 flex items-center justify-center">
                <IllustrationComponent class="w-full h-36 object-contain mx-auto" />
              </div>

              {/* Title & Description */}
              <div class="space-y-1.5 pt-1">
                <h3 class="text-lg font-semibold text-[#171717] tracking-tight">
                  {item.title}
                </h3>
                <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>

            {/* Tag Chips (Standard Rounded, NOT Pill) */}
            <div class="pt-4 border-t border-[#E5E2DC] flex flex-wrap gap-2">
              {item.chips.map((chip) => (
                <span class="px-2.5 py-1 rounded-md bg-[#FAF9F7] text-[11px] font-medium text-[#5F5C57]">
                  {chip}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

