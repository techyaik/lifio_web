---
import HealthIllustration from './illustrations/HealthIllustration.astro';
import HabitsIllustration from './illustrations/HabitsIllustration.astro';
import NotesIllustration from './illustrations/NotesIllustration.astro';
import WalletIllustration from './illustrations/WalletIllustration.astro';
import OfflineVaultIllustration from './illustrations/OfflineVaultIllustration.astro';
import DailyClarityIllustration from './illustrations/DailyClarityIllustration.astro';

interface FeatureItem {
  module: string;
  tag: string;
  tagBg: string;
  tagDot: string;
  title: string;
  desc: string;
  component: typeof HealthIllustration;
  chips: string[];
}

const features: FeatureItem[] = [
  {
    module: '01 / Health',
    tag: 'Health Connect',
    tagBg: 'bg-[#F5F8EF]',
    tagDot: 'bg-[#8DAF2B]',
    title: 'Physical Wellness & Vitals',
    desc: 'Sync steps, sleep stages, active minutes, and resting heart rate via Google Health Connect. Stays 100% on-device.',
    component: HealthIllustration,
    chips: ['Steps & Sleep', 'Heart Rate BPM', 'Read-Only Sync']
  },
  {
    module: '02 / Habits',
    tag: 'Streak Rings',
    tagBg: 'bg-[#FAF7ED]',
    tagDot: 'bg-[#FFBB2C]',
    title: 'Habit Streaks & Routines',
    desc: 'Build daily consistency with custom checklists, milestone streaks, and gentle local system alarms that respect your time.',
    component: HabitsIllustration,
    chips: ['Daily Checklists', 'Milestone Flames', 'Local Alarms']
  },
  {
    module: '03 / Notes',
    tag: 'Instant Search',
    tagBg: 'bg-[#F7F5FA]',
    tagDot: 'bg-[#DCD7F4]',
    title: 'Mindful Journal & Notes',
    desc: 'Capture reflections, ideas, and priority checklists. Search through your thoughts instantly in local phone memory.',
    component: NotesIllustration,
    chips: ['Morning Prompts', 'Custom Tags', 'Pinned Notes']
  },
  {
    module: '04 / Expenses',
    tag: 'Multi-Wallet',
    tagBg: 'bg-[#FAF5F7]',
    tagDot: 'bg-[#805044]',
    title: 'Spending & Wallet Budgets',
    desc: 'Track daily expenses, manage category limits, and monitor multiple accounts without ever linking sensitive bank logins.',
    component: WalletIllustration,
    chips: ['Hidden Balances', 'Multi-Account', 'Zero Bank Logins']
  },
  {
    module: '05 / Privacy',
    tag: 'SQLite Sandbox',
    tagBg: 'bg-[#F5F8EF]',
    tagDot: 'bg-[#8DAF2B]',
    title: '100% Offline & Accountless',
    desc: 'Launch instantly with zero accounts or email collection. Your database lives purely inside your encrypted phone sandbox.',
    component: OfflineVaultIllustration,
    chips: ['Zero Accounts', 'No Cloud Servers', 'Instant Launch']
  },
  {
    module: '06 / Clarity',
    tag: 'All-In-One',
    tagBg: 'bg-[#FAF7ED]',
    tagDot: 'bg-[#FFBB2C]',
    title: 'Unified Daily Focus',
    desc: 'View your vitals, habits, reflections, and wallet balance on one calm screen without switching between 4 separate SaaS tools.',
    component: DailyClarityIllustration,
    chips: ['One Quiet View', 'Zero Ad Distractions', 'Ultra Lightweight']
  }
];
---

<section id="features" class="py-20 md:py-28 bg-[#F0EFEB] border-t border-[#E5E2DC]">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
    
    {/* Section Header */}
    <div class="max-w-xl space-y-2.5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-[#FFFFFF] border border-[#E5E2DC] text-xs font-semibold text-[#171717]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FFBB2C]"></span>
        <span class="text-[#5F5C57] font-medium">Core Capabilities</span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-bold text-[#171717] tracking-[-0.025em] leading-[1.15]">
        Six essential tools, unified in one quiet app.
      </h2>

      <p class="text-base text-[#5F5C57] font-normal leading-relaxed">
        Everything you need for everyday physical wellness, habit formation, reflection, and money tracking—without clutter or cloud dependencies.
      </p>
    </div>

    {/* 1/3 * 2 = 6-Item Feature Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((item) => {
        const IllustrationComponent = item.component;
        return (
          <div class="bg-[#FFFFFF] rounded-2xl p-7 border border-[#E5E2DC] flex flex-col justify-between space-y-5 hover:border-[#D8D4CC] transition-all">
            <div class="space-y-4">
              {/* Header Row */}
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-[#858174]">{item.module}</span>
                <span class={`h-6 px-2.5 rounded-lg ${item.tagBg} text-xs font-medium text-[#171717] border border-[#E5E2DC] flex items-center gap-1.5`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${item.tagDot}`}></span>
                  {item.tag}
                </span>
              </div>

              {/* Transparent Vector Illustration */}
              <div class="py-2 flex items-center justify-center">
                <IllustrationComponent class="w-full h-36 object-contain mx-auto" />
              </div>

              {/* Title & Description */}
              <div class="space-y-1.5 pt-1">
                <h3 class="text-lg font-semibold text-[#171717] tracking-tight">
                  {item.title}
                </h3>
                <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>

            {/* Tag Chips (Standard Rounded, NOT Pill) */}
            <div class="pt-4 border-t border-[#E5E2DC] flex flex-wrap gap-2">
              {item.chips.map((chip) => (
                <span class="px-2.5 py-1 rounded-md bg-[#FAF9F7] text-[11px] font-medium text-[#5F5C57]">
                  {chip}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

