---
import { Zap, Battery, Layers, Check, X, Sparkles } from 'lucide-react';

interface ComparisonItem {
  feature: string;
  separate: string;
  lifio: string;
  highlight: boolean;
}

const comparisonItems: ComparisonItem[] = [
  {
    feature: 'App Storage & Disk Space',
    separate: '4 separate apps (400 MB+ total)',
    lifio: '1 ultra-light unified app (< 25 MB)',
    highlight: true
  },
  {
    feature: 'Battery & RAM Consumption',
    separate: '4 background sync daemons draining battery',
    lifio: 'Single local process, 90% less RAM',
    highlight: true
  },
  {
    feature: 'Account Registration & Passwords',
    separate: '4 logins, passwords & email verifications',
    lifio: 'Zero accounts required. Instant open',
    highlight: false
  },
  {
    feature: 'Data Privacy & Telemetry',
    separate: 'Multiple cloud databases & ad trackers',
    lifio: '100% on-device SQLite database',
    highlight: true
  },
  {
    feature: 'Subscription Costs',
    separate: '$15–$30/month across multiple SaaS apps',
    lifio: '100% Free with zero recurring traps',
    highlight: false
  }
];
---

<section id="benefits" class="py-20 sm:py-28 bg-[#F0EFEB]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
    
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white border border-[#E5E2DC] text-xs font-medium text-[#171717]">
        <Zap className="w-3.5 h-3.5 text-[#FFBB2C]" />
        <span class="uppercase tracking-wider text-[11px] font-semibold text-[#5F5C57]">Unmatched Efficiency</span>
      </div>

      <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] tracking-tight">
        Why replace 4 separate apps with Lifio?
      </h2>

      <p class="text-sm sm:text-base text-[#5F5C57] font-normal leading-relaxed">
        Running separate tools for Health, Habits, Notes, and Expenses drains your battery, fragments your focus, and scatters your personal data.
      </p>
    </div>

    {/* 3 Pure White Bento Cards */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="bg-[#FFFFFF] p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] space-y-4">
        <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] text-[#FFBB2C] flex items-center justify-center">
          <Zap className="w-5 h-5 stroke-[2]" />
        </div>
        <h3 class="text-lg font-semibold text-[#171717] tracking-tight">
          Instant Speed & Launch
        </h3>
        <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
          Opens in milliseconds. Log steps, daily spending, or quick note ideas without waiting for cloud sync spinners or splash screens.
        </p>
      </div>

      <div class="bg-[#FFFFFF] p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] space-y-4">
        <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] text-[#FFBB2C] flex items-center justify-center">
          <Battery className="w-5 h-5 stroke-[2]" />
        </div>
        <h3 class="text-lg font-semibold text-[#171717] tracking-tight">
          Maximum Battery Health
        </h3>
        <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
          Saves background battery cycles and memory overhead by eliminating third-party analytics pings and ad tracking services.
        </p>
      </div>

      <div class="bg-[#FFFFFF] p-7 sm:p-8 rounded-[24px] border border-[#E5E2DC] space-y-4">
        <div class="w-12 h-12 rounded-xl bg-[#FEF7E6] text-[#FFBB2C] flex items-center justify-center">
          <Layers className="w-5 h-5 stroke-[2]" />
        </div>
        <h3 class="text-lg font-semibold text-[#171717] tracking-tight">
          Unified Daily Clarity
        </h3>
        <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
          View your vitals, habits, pinned notes, and monthly budget on one clean dashboard without switching back and forth between apps.
        </p>
      </div>

    </div>

    {/* Detailed Comparison Matrix Card */}
    <div class="bg-[#FFFFFF] rounded-[24px] border border-[#E5E2DC] overflow-hidden">
      
      <div class="p-6 sm:p-8 border-b border-[#E5E2DC] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-[11px] font-medium text-[#858174] uppercase tracking-wider block mb-1">Direct Comparison</span>
          <h3 class="text-xl font-semibold text-[#171717]">4 Separate SaaS Apps vs. Lifio</h3>
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#F0EFEB] rounded-lg border border-[#E5E2DC] text-xs text-[#5F5C57] font-medium self-start sm:self-auto">
          <Sparkles className="w-3.5 h-3.5 text-[#FFBB2C]" />
          <span>Tested on Android 14</span>
        </div>
      </div>

      <div class="divide-y divide-[#E5E2DC]">
        {comparisonItems.map((item) => (
          <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-12 gap-3 sm:gap-4 items-center hover:bg-[#FAF9F7] transition-colors">
            
            <div class="md:col-span-4 font-medium text-[#171717] text-sm">
              {item.feature}
            </div>

            <div class="md:col-span-4 flex items-center gap-2.5 text-sm text-[#858174] font-normal">
              <div class="w-5 h-5 rounded-full bg-[#FAF0EE] text-[#805044] flex items-center justify-center flex-shrink-0">
                <X className="w-3 h-3 stroke-[2.5]" />
              </div>
              <span>{item.separate}</span>
            </div>

            <div class="md:col-span-4 flex items-center gap-2.5 text-sm font-medium text-[#171717]">
              <div class="w-5 h-5 rounded-full bg-[#FEF7E6] text-[#FFBB2C] flex items-center justify-center flex-shrink-0">
                <Check className="w-3 h-3 stroke-[2.5]" />
              </div>
              <span class={item.highlight ? 'text-[#171717] font-semibold' : ''}>{item.lifio}</span>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

