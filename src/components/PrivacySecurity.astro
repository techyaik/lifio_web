---
import { ShieldCheck, Lock, Smartphone, EyeOff, ServerOff, Check, Mail, ArrowRight } from 'lucide-react';
import OfflineVaultIllustration from './illustrations/OfflineVaultIllustration.astro';

interface PrivacyPillar {
  title: string;
  desc: string;
  badge: string;
  iconType: 'lock' | 'smartphone' | 'serverOff' | 'eyeOff';
}

const privacyPillars: PrivacyPillar[] = [
  {
    iconType: 'lock',
    title: 'Zero Account Requirement',
    desc: 'No registration forms, no email collection, and no passwords. Launch Lifio instantly on your phone without ever signing up.',
    badge: '100% Accountless'
  },
  {
    iconType: 'smartphone',
    title: 'Local On-Device Database',
    desc: 'All wellness scores, sleep hours, habit logs, thoughts, and spending records stay saved strictly inside your local SQLite database.',
    badge: 'SQLite Sandbox'
  },
  {
    iconType: 'serverOff',
    title: 'Zero Third-Party Trackers',
    desc: 'Lifio does not run tracking servers or embed behavioral profiling frameworks (no Firebase Analytics, no Meta SDK, no AdMob).',
    badge: 'Zero Ad SDKs'
  },
  {
    iconType: 'eyeOff',
    title: 'Complete User Sovereignty',
    desc: 'Your data is 100% under your ownership. Export full backups anytime or permanently wipe all records in one tap.',
    badge: 'User Controlled'
  }
];
---

<section id="privacy" class="py-20 sm:py-28 bg-[#F0EFEB] border-t border-[#E5E2DC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
    
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white border border-[#E5E2DC] text-xs font-medium text-[#171717]">
        <ShieldCheck className="w-3.5 h-3.5 text-[#8DAF2B]" />
        <span class="uppercase tracking-wider text-[11px] font-semibold text-[#5F5C57]">Privacy Sanctuary</span>
      </div>

      <h2 class="text-2xl sm:text-4xl font-bold text-[#171717] tracking-tight">
        Your personal data stays on your phone. Period.
      </h2>

      <p class="text-sm sm:text-base text-[#5F5C57] font-normal leading-relaxed">
        We believe your daily vitals, financial spending, and private thoughts belong only to you. Lifio is architected for complete on-device security.
      </p>

      <div class="pt-2">
        <a 
          href="/privacy" 
          class="inline-flex items-center gap-2 text-xs font-semibold text-[#171717] bg-white border border-[#E5E2DC] px-5 py-2.5 rounded-xl hover:bg-[#FAF9F7] shadow-sm transition-all"
        >
          <ShieldCheck className="w-3.5 h-3.5 text-[#8DAF2B]" />
          <span>Read Full Standalone Privacy Policy</span>
          <ArrowRight className="w-3.5 h-3.5 text-[#858174]" />
        </a>
      </div>
    </div>

    {/* 4 Pure White Privacy Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {privacyPillars.map((pillar) => (
        <div class="bg-[#FFFFFF] p-7 sm:p-8 rounded-2xl border border-[#E5E2DC] flex flex-col justify-between space-y-6 hover:border-[#D8D4CC] transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-11 h-11 rounded-xl bg-[#FAF9F7] border border-[#E5E2DC] flex items-center justify-center">
                {pillar.iconType === 'lock' && <Lock className="w-5 h-5 text-[#FFBB2C] stroke-[2]" />}
                {pillar.iconType === 'smartphone' && <Smartphone className="w-5 h-5 text-[#8DAF2B] stroke-[2]" />}
                {pillar.iconType === 'serverOff' && <ServerOff className="w-5 h-5 text-[#805044] stroke-[2]" />}
                {pillar.iconType === 'eyeOff' && <EyeOff className="w-5 h-5 text-[#DCD7F4] stroke-[2]" />}
              </div>
              <span class="text-[11px] font-medium border border-[#E5E2DC] bg-[#FAF9F7] text-[#5F5C57] px-3 py-1 rounded-lg uppercase tracking-wider">
                {pillar.badge}
              </span>
            </div>

            <h3 class="text-lg font-semibold text-[#171717] tracking-tight">
              {pillar.title}
            </h3>

            <p class="text-sm font-normal text-[#5F5C57] leading-relaxed">
              {pillar.desc}
            </p>
          </div>

          <div class="pt-4 flex items-center gap-2 text-xs font-normal text-[#858174] border-t border-[#E5E2DC]">
            <Check className="w-3.5 h-3.5 text-[#8DAF2B] stroke-[2.5]" />
            <span>Verified offline Android app sandbox</span>
          </div>
        </div>
      ))}
    </div>

    {/* Developer Transparency Contact Card with Transparent Illustration */}
    <div class="bg-[#FFFFFF] rounded-2xl p-7 sm:p-10 border border-[#E5E2DC] flex flex-col md:flex-row items-center justify-between gap-8">
      
      <div class="w-48 h-36 flex-shrink-0 flex items-center justify-center">
        <OfflineVaultIllustration class="w-full h-full object-contain" />
      </div>

      <div class="space-y-2 text-center md:text-left flex-1">
        <span class="text-[11px] font-medium text-[#858174] uppercase tracking-wider block">Direct Developer Contact</span>
        <h3 class="text-xl sm:text-2xl font-bold text-[#171717]">Have questions about offline security?</h3>
        <p class="text-sm font-normal text-[#5F5C57] max-w-xl">
          Reach out directly to the lead creator of Lifio. All privacy and technical inquiries are answered personally within 24 to 48 hours.
        </p>
      </div>

      <a
        href="mailto:imran@idexa.app"
        class="inline-flex items-center gap-2 bg-[#FFBB2C] hover:bg-[#f0ad24] text-[#171717] font-semibold px-6 py-3 rounded-xl text-sm shadow-sm transition-all flex-shrink-0"
      >
        <Mail className="w-3.5 h-3.5 stroke-[2]" />
        <span>imran@idexa.app</span>
      </a>
    </div>

  </div>
</section>

